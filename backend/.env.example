# Copy to backend/.env (never commit .env)

PORT=8080

# Neon Postgres: Neon console -> your project -> Connection string (pooled is fine).
# Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/gigvault?sslmode=require

# mock = offline stand-in (UI shows a MOCK badge). live = real Busha API.
BUSHA_MODE=mock
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=
BUSHA_PUBLIC_KEY=
# Optional: act on behalf of a Busha customer profile
BUSHA_PROFILE_ID=
# From Busha dashboard -> Settings -> Developer Tools -> Webhooks (shown once)
BUSHA_WEBHOOK_SECRET=dev-webhook-secret

# Escrow rules
DEPOSIT_BPS=2500          # 25% released at booking
FREEZE_BPS=5000           # a complaint freezes 50% of what is left
COMPLAINT_WINDOW=60s      # 6h in the pitch; 60s for the demo
LATE_CANCEL_WINDOW=24h    # cancelling within 24h of the event keeps the deposit with the worker
MOCK_RATE_NGN=1600        # NGN per USDT, mock mode only

ALLOW_DEV_ROUTES=true     # enables POST /v1/dev/gigs/{id}/simulate-payment
CORS_ORIGIN=http://localhost:5173

# Accounts
AUTH_SECRET=change-me-to-a-long-random-string   # signs login sessions
ADMIN_KEY=dev-admin                             # X-Admin-Key for /v1/admin/*
