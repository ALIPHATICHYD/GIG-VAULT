# GigVault Environment Configuration
# Copy to `.env.local` (or `backend/.env`) — never commit `.env` or `.env.local`
# Or run `neon link --project-id dry-haze-50893156 -y` to pull the Neon vars automatically.

# --- Neon Lakebase Postgres (pulled automatically by `neon env pull` / `neon deploy`) ---
# Pooled connection string (-pooler) used by the Go API & worker pool:
DATABASE_URL='postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Direct (unpooled) connection string used for startup SQL schema migrations:
DATABASE_URL_UNPOOLED='postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
NEON_BRANCH=production
NEON_BRANCH_ID=br-small-night-b9xek8ai
NEON_FUNCTION_HOST_SUFFIX=fn-xxxx.c-2.eu-central-1.aws.neon.com

# --- Server & Frontend ---
PORT=8080
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080

# --- Busha Business API ---
# mock = offline stand-in (UI shows a MOCK badge). live = real Busha API.
BUSHA_MODE=mock
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=
BUSHA_PUBLIC_KEY=
# Optional: act on behalf of a Busha customer profile
BUSHA_PROFILE_ID=
# From Busha dashboard -> Settings -> Developer Tools -> Webhooks (shown once)
BUSHA_WEBHOOK_SECRET=dev-webhook-secret

# --- Escrow & Dispute Rules ---
DEPOSIT_BPS=2000          # default upfront: 20% released when the client pays (creator can pick 0-70% per invoice)
MAX_DEPOSIT_BPS=7000      # most a creator can ask upfront
DISPUTE_WINDOW=72h        # time for both sides to agree a split (use 2m for the demo)
DISPUTE_FEE_BPS=1000      # GigVault keeps 10% of the frozen money if it has to step in
FREEZE_BPS=5000           # a complaint freezes 50% of what is left
COMPLAINT_WINDOW=60s      # 6h in the pitch; 60s for the demo
LATE_CANCEL_WINDOW=24h    # cancelling within 24h of the event keeps the deposit with the worker
MOCK_RATE_NGN=1600        # NGN per USDT, mock mode only

# --- Dev & Auth ---
ALLOW_DEV_ROUTES=true                           # enables POST /v1/dev/gigs/{id}/simulate-payment
AUTH_SECRET=change-me-to-a-long-random-string   # signs login sessions
ADMIN_KEY=dev-admin                             # X-Admin-Key for /v1/admin/*

